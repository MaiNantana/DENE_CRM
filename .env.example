# --- Slip verification (free, self-hosted: QR decode + OCR, no external API) ---
# The slip QR is decoded locally to confirm a genuine Thai bank slip (CRC + NITMX AID)
# and to detect duplicates. The amount is read with OCR (tesseract.js); the shop still
# confirms it on approval. NOTE: the slip QR does NOT contain the amount or the receiving
# account — those cannot be verified without a bank/3rd-party API (e.g. SlipOK/EasySlip).
#
# Optional secret used to sign slip verification tokens.
SLIP_ANALYSIS_SECRET="MY_SLIP_ANALYSIS_SECRET"
# Optional: enable/disable OCR amount reading (true/false). Default true.
SLIP_OCR_ENABLED="true"
# Optional: tesseract.js languages for OCR. "eng" is enough for digits; add "+tha" for Thai text.
SLIP_OCR_LANGS="eng"
# Optional: max image width (px) used when scanning the QR. Default 1600.
SLIP_QR_MAX_WIDTH="1600"
# Optional storage directory for verified slip images.
SLIP_STORAGE_DIR="server/uploads/slips"

# --- LINE Messaging API (receive slips via chat) ---
# Each company's LINE OA is a separate Messaging API channel. Set its webhook URL to:
#   https://<your-domain>/api/line/webhook/dene     (for DENE)
#   https://<your-domain>/api/line/webhook/kefera    (for KEFERA)
# Find the secret + long-lived access token in the LINE Developers console for each channel.
LINE_CHANNEL_SECRET_DENE="MY_DENE_CHANNEL_SECRET"
LINE_CHANNEL_ACCESS_TOKEN_DENE="MY_DENE_CHANNEL_ACCESS_TOKEN"
LINE_CHANNEL_SECRET_KEFERA="MY_KEFERA_CHANNEL_SECRET"
LINE_CHANNEL_ACCESS_TOKEN_KEFERA="MY_KEFERA_CHANNEL_ACCESS_TOKEN"

# APP_URL (public base URL of the site; LIFF lives under /liff)
APP_URL="MY_APP_URL"

# LIFF
# ใช้ค่าเดียวกันทั้งฝั่งหน้าเว็บและสคริปต์สร้าง rich menu
VITE_LIFF_ID="MY_LIFF_ID"
VITE_LIFF_ID_DENE="MY_DENE_LIFF_ID"
VITE_LIFF_ID_KEFERA="MY_KEFERA_LIFF_ID"

# Database
DB_HOST=hr.iexcellence.cloud
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=mtcrm

# Backend API port
PORT=3001

# Auth
AUTH_SECRET=change_this_to_a_long_random_secret
AUTH_SESSION_TTL_MS=43200000
AUTH_COOKIE_SECURE=0
